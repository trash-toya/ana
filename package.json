{
  "name": "session-analytics",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r build && tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r build",
    "test": "pnpm -r build && vitest run",
    "test:shared": "pnpm -F @session-analytics/shared build && vitest run packages/shared/test",
    "test:ingest": "pnpm -F @session-analytics/ingest build && vitest run services/ingest/test",
    "test:sdk": "pnpm -F @session-analytics/sdk-web build && vitest run packages/sdk-web/test",
    "test:server-sdk": "pnpm -F @session-analytics/sdk-server build && vitest run packages/sdk-server/test",
    "demo": "node demo/run.mjs",
    "db:up": "docker compose -f ops/docker-compose.yml up -d",
    "db:down": "docker compose -f ops/docker-compose.yml down",
    "db:ping": "node db/test/scripts/db-ping.mjs",
    "db:migrate": "node db/test/scripts/migrate.mjs",
    "test:db": "vitest run db/test",
    "test:db:concurrency": "vitest run db/test/concurrency",
    "test:property": "vitest run db/test/property",
    "bench:p0": "node ops/loadtest/p0-bench.mjs",
    "bench:p3": "pnpm -F @session-analytics/dashboard build && node ops/loadtest/p3-bench.mjs",
    "prepare": "husky"
  },
  "nano-staged": {
    "*.{js,mjs,cjs,ts}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "!ops/**": []
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "pg": "^8.13.0",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
